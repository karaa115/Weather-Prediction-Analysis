statystyki <- function(x) {
M1 <- moment(x, order = 1, central = FALSE, na.rm = TRUE)
M2 <- moment(x, order = 2, central = TRUE,  na.rm = TRUE)
mu  <- M1
sig <- sqrt(M2)
c(
srednia    = mu,
odchylenie = sig,
minimum    = min(x,    na.rm = TRUE),
mediana    = median(x, na.rm = TRUE),
maksimum   = max(x,    na.rm = TRUE)
)
}
stat_eur <- statystyki(coredata(eur_r))
stat_usd <- statystyki(coredata(usd_r))
stat_chf <- statystyki(coredata(chf_r))
stat_eur
stat_usd
stat_chf
