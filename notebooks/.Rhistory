set.seed(123)
n <- 10000
# Trzy rozkłady
x1 <- rnorm(n, mean = 0, sd = 1)
x2 <- rnorm(n, mean = 3, sd = 1)
x3 <- rnorm(n, mean = 10, sd = sqrt(0.5))
# Suma rozkładów
suma <- x1 + x2 + x3
# Mieszanina rozkładów z prawdopodobieństwami 0.3, 0.5, 0.2
u <- runif(n)
mieszanina <- numeric(n)
mieszanina[u < 0.3] <- x1[u < 0.3]
mieszanina[u >= 0.3 & u < 0.8] <- x2[u >= 0.3 & u < 0.8]
mieszanina[u >= 0.8] <- x3[u >= 0.8]
# Wyniki empiryczne
mean(suma)
var(suma)
mean(mieszanina)
var(mieszanina)
# Wartości teoretyczne dla sumy
srednia_suma_teo <- 0 + 3 + 10
wariancja_suma_teo <- 1 + 1 + 0.5
srednia_suma_teo
wariancja_suma_teo
# Wartości teoretyczne dla mieszaniny
p <- c(0.3, 0.5, 0.2)
mu <- c(0, 3, 10)
var <- c(1, 1, 0.5)
srednia_mix_teo <- sum(p * mu)
EX2 <- sum(p * (var + mu^2))
wariancja_mix_teo <- EX2 - srednia_mix_teo^2
srednia_mix_teo
wariancja_mix_teo
# Wykresy
par(mfrow = c(1, 2))
hist(suma,
prob = TRUE,
main = "Suma",
xlab = "x")
hist(mieszanina,
prob = TRUE,
main = "Mieszanina",
xlab = "x")
