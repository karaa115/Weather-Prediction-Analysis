cat("\014")
set.seed(123)
m <- 1000
n_vec <- c(20, 75, 145)
alpha <- 0.05
mu0 <- 0
mu1 <- 0.4
sigma <- 1
wyniki <- data.frame(n=n_vec, blad_I=NA, blad_II=NA, moc=NA)
for(i in seq_along(n_vec)){
n <- n_vec[i]
p0 <- numeric(m)
p1 <- numeric(m)
for(j in 1:m){
x0 <- rnorm(n, mu0, sigma)
x1 <- rnorm(n, mu1, sigma)
p0[j] <- t.test(x0, mu=mu0)$p.value
p1[j] <- t.test(x1, mu=mu0)$p.value
}
wyniki$blad_I[i] <- mean(p0 < alpha)
wyniki$moc[i] <- mean(p1 < alpha)
wyniki$blad_II[i] <- 1 - wyniki$moc[i]
}
wyniki
